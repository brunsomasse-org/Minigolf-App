PORT=8080
NODE_ENV=development

# Local dev matches the docker-compose Postgres service.
# In production this points at the managed Cloud SQL / Azure Database
# for PostgreSQL instance instead — never a self-hosted DB container.
DATABASE_URL=postgresql://umb:umb_dev_password@localhost:5432/umb_backend

# Filled in once a provider is actually chosen and the integration begins.
# Never commit real values — these belong in Secret Manager / Key Vault
# in production, not in a .env file.
FEDAPAY_API_KEY=
FEDAPAY_WEBHOOK_SECRET=
KKIAPAY_API_KEY=
KKIAPAY_WEBHOOK_SECRET=
